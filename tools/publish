#!/usr/bin/env bash

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
registry_url="https://registry.npmjs.org/"
package_name="@albus/sdk"

usage() {
    cat >&2 <<EOF
usage: $0 [--dry-run] <sdk-version>

Validate and publish the generated SDK from a clean, pushed commit.

  --dry-run    Validate the complete release without uploading.
EOF
}

dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "error: unknown option: $1" >&2
            usage
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -ne 1 ]]; then
    usage
    exit 2
fi

sdk_version="$1"

for command in git node npm; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "error: required command not found: $command" >&2
        exit 1
    fi
done

cd "$repo_root"

node tools/release-metadata.mjs versions "$sdk_version"

if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    echo "error: releases require a clean worktree" >&2
    exit 1
fi

branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ -z "$branch" ]]; then
    echo "error: releases cannot run from a detached HEAD" >&2
    exit 1
fi

remote="$(git config --get "branch.$branch.remote" || true)"
merge_ref="$(git config --get "branch.$branch.merge" || true)"
if [[ -z "$remote" || -z "$merge_ref" ]]; then
    echo "error: branch $branch does not have an upstream" >&2
    exit 1
fi

if ! remote_output="$(git ls-remote --exit-code --refs "$remote" "$merge_ref")"
then
    echo "error: upstream ref $merge_ref does not exist on $remote" >&2
    exit 1
fi

remote_sha="$(awk 'NR == 1 { print $1 }' <<<"$remote_output")"
local_sha="$(git rev-parse HEAD)"
if [[ "$remote_sha" != "$local_sha" ]]; then
    upstream_branch="${merge_ref#refs/heads/}"
    echo "error: HEAD is not the commit pushed to" \
        "$remote/$upstream_branch" >&2
    exit 1
fi

if [[ "$dry_run" == false && "$branch" != "master" ]]; then
    echo "error: uploads must run from the master branch" >&2
    exit 1
fi

if [[ "$sdk_version" == *-* ]]; then
    dist_tag="next"
else
    dist_tag="latest"
fi

if published_output="$(
    npm view \
        "$package_name@$sdk_version" \
        version \
        --registry="$registry_url" \
        2>&1
)"; then
    echo "error: $package_name@$sdk_version is already published" >&2
    exit 1
elif [[ "$published_output" != *"E404"* ]]; then
    echo "$published_output" >&2
    echo "error: could not confirm that the version is unpublished" >&2
    exit 1
fi

./tools/check

if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    echo "error: release checks changed the worktree" >&2
    exit 1
fi

publish_args=(
    --access public
    --tag "$dist_tag"
    --registry "$registry_url"
)

if [[ "$dry_run" == true ]]; then
    npm publish --dry-run "${publish_args[@]}"
    echo "Dry run complete. No package was uploaded."
    exit 0
fi

auth_file=""
cleanup() {
    if [[ -n "$auth_file" ]]; then
        rm -f -- "$auth_file"
    fi
}
trap cleanup EXIT

auth_args=()
if [[ -n "${NPM_TOKEN:-}" ]]; then
    old_umask="$(umask)"
    umask 077
    auth_file="$(mktemp)"
    umask "$old_umask"
    printf '//registry.npmjs.org/:_authToken=%s\n' \
        "$NPM_TOKEN" >"$auth_file"
    auth_args=(--userconfig "$auth_file")
fi

if ! npm whoami \
    "${auth_args[@]}" \
    --registry="$registry_url" \
    >/dev/null
then
    echo "error: authenticate with 'npm login' or set NPM_TOKEN" >&2
    exit 1
fi

if [[ ! -t 0 ]]; then
    echo "error: publishing requires an interactive confirmation" >&2
    exit 1
fi

confirmation_prompt="publish $package_name@$sdk_version with tag $dist_tag"
read -r -p "Type '$confirmation_prompt' to continue: " confirmation
if [[ "$confirmation" != "$confirmation_prompt" ]]; then
    echo "Publication cancelled." >&2
    exit 1
fi

npm publish "${auth_args[@]}" "${publish_args[@]}"
echo "Published $package_name@$sdk_version with npm tag $dist_tag."
