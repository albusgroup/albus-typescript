#!/usr/bin/env bash

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
registry_url="https://registry.npmjs.org/"
package_name="@albus-ts/sdk"

usage() {
    cat >&2 <<EOF
usage: $0 [--dry-run] <sdk-version>

Validate and publish the generated SDK from a clean, pushed commit.

  --dry-run    Validate the complete release without uploading.
EOF
}

dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "error: unknown option: $1" >&2
            usage
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -ne 1 ]]; then
    usage
    exit 2
fi

sdk_version="$1"

for command in git node npm; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "error: required command not found: $command" >&2
        exit 1
    fi
done

cd "$repo_root"

# shellcheck source=tools/release-state.sh
source "$script_dir/release-state.sh"

require_release_state "$sdk_version"

if [[ "$dry_run" == false && "$release_branch" != "master" ]]; then
    echo "error: uploads must run from the master branch" >&2
    exit 1
fi

if [[ "$sdk_version" == *-* ]]; then
    dist_tag="next"
else
    dist_tag="latest"
fi

if published_output="$(
    npm view \
        "$package_name@$sdk_version" \
        version \
        --registry="$registry_url" \
        2>&1
)"; then
    echo "error: $package_name@$sdk_version is already published" >&2
    exit 1
elif [[ "$published_output" != *"E404"* ]]; then
    echo "$published_output" >&2
    echo "error: could not confirm that the version is unpublished" >&2
    exit 1
fi

./tools/check

if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    echo "error: release checks changed the worktree" >&2
    exit 1
fi

publish_args=(
    --access public
    --tag "$dist_tag"
    --registry "$registry_url"
)

if [[ "$dry_run" == true ]]; then
    npm publish --dry-run "${publish_args[@]}"
    echo "Dry run complete. No package was uploaded."
    exit 0
fi

auth_file=""
cleanup() {
    if [[ -n "$auth_file" ]]; then
        rm -f -- "$auth_file"
    fi
}
trap cleanup EXIT

if [[ -n "${NPM_TOKEN:-}" ]]; then
    old_umask="$(umask)"
    umask 077
    auth_file="$(mktemp)"
    umask "$old_umask"
    printf '//registry.npmjs.org/:_authToken=%s\n' \
        "$NPM_TOKEN" >"$auth_file"
fi

if [[ -n "$auth_file" ]]; then
    npm_auth_status=0
    npm whoami \
        --userconfig "$auth_file" \
        --registry="$registry_url" \
        >/dev/null || npm_auth_status=$?
else
    npm_auth_status=0
    npm whoami \
        --registry="$registry_url" \
        >/dev/null || npm_auth_status=$?
fi

if [[ "$npm_auth_status" -ne 0 ]]; then
    echo "error: authenticate with 'npm login' or set NPM_TOKEN" >&2
    exit 1
fi

if [[ ! -t 0 ]]; then
    echo "error: publishing requires an interactive confirmation" >&2
    exit 1
fi

confirmation_prompt="publish $package_name@$sdk_version with tag $dist_tag"
read -r -p "Type '$confirmation_prompt' to continue: " confirmation
if [[ "$confirmation" != "$confirmation_prompt" ]]; then
    echo "Publication cancelled." >&2
    exit 1
fi

if [[ -n "$auth_file" ]]; then
    npm publish --userconfig "$auth_file" "${publish_args[@]}"
else
    npm publish "${publish_args[@]}"
fi
echo "Published $package_name@$sdk_version with npm tag $dist_tag."
